function runFleetImportOnly() {
  Log_.init();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT');
  FleetImport_.importAccuracyReports_(ss, { clearBeforeImport: true }, log);
  Log_.writeToSheet(ss);
}

function runFleetImportAndAssay() {
  Log_.init();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT');
  
  PropertiesService.getScriptProperties().setProperty('FI_CHAIN_ASSAY', 'true');
  
  const done = FleetImport_.importAccuracyReports_(ss, { clearBeforeImport: true }, log);
  if (done !== false) {
    PropertiesService.getScriptProperties().deleteProperty('FI_CHAIN_ASSAY');
    log.info('Fleet import finished synchronously. Triggering Main_.runAssay()...');
    Log_.writeToSheet(ss);
    Main_.runAssay();
  } else {
    log.info('Fleet import paused for quota. Main_.runAssay() will execute upon final resume completion.');
    Log_.writeToSheet(ss);
  }
}

function runFleetImportTest() {
  Log_.init();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT_TEST');
  log.info('TEST RUN — limit=3 satellites');
  FleetImport_.importAccuracyReports_(ss, { limit: 3, clearBeforeImport: true }, log);
  Log_.writeToSheet(ss);
}

function runFleetImportResume() {
  // Cancel the trigger that fired us so it doesn't stack
  FleetImport_._cancelResumeTimer_();
  Log_.init();
  const ss  = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT');
  const done = FleetImport_.importAccuracyReports_(ss, { resume: true }, log);
  if (done !== false) {
    // Completed — cancel any leftover timer
    FleetImport_._cancelResumeTimer_();
    
    // Check if we need to chain into runAssay
    const props = PropertiesService.getScriptProperties();
    if (props.getProperty('FI_CHAIN_ASSAY') === 'true') {
      props.deleteProperty('FI_CHAIN_ASSAY');
      log.info('Fleet import finished on resume. Triggering Main_.runAssay()...');
      Log_.writeToSheet(ss);
      Main_.runAssay();
      return;
    }
  }
  Log_.writeToSheet(ss);
}

function resetFleetImport() {
  FleetImport_._cancelResumeTimer_();
  const props = PropertiesService.getScriptProperties();
  props.deleteProperty(FleetImport_.PROP_RESUME_IDX);
  props.deleteProperty(FleetImport_.PROP_RUN_ID);
  Logger.log('FleetImport resume state + timer cleared.');
}

// ─────────────────────────────────────────────────────────────────────────────
// DEBUG UTILITY: wipe all intake sheets + reset state for a clean run
// ─────────────────────────────────────────────────────────────────────────────

function clearAllIntakeData() {
  FleetImport_._cancelResumeTimer_();

  const props = PropertiesService.getScriptProperties();
  props.deleteProperty(FleetImport_.PROP_RESUME_IDX);
  props.deleteProperty(FleetImport_.PROP_RUN_ID);

  const ss      = SpreadsheetApp.getActiveSpreadsheet();
  const log     = Log_.module ? Log_.module('CLEAR') : console;
  const sheets  = ss.getSheets();
  const cleared = [];

  sheets.forEach(sh => {
    const name = sh.getName();
    if (
      FleetImport_.MANAGED_SHEET_RE.test(name) &&
      !FleetImport_.PROTECTED_SHEETS.has(name) &&
      name !== 'MA_ImportReport'
    ) {
      sh.clearContents();
      cleared.push(name);
    }
  });

  Logger.log(`clearAllIntakeData: cleared ${cleared.length} sheets — ${cleared.join(', ')}`);
  if (log.info) log.info(`Cleared ${cleared.length} intake sheets. Resume state reset.`);
}


// ─────────────────────────────────────────────────────────────────────────────
// DIAGNOSTIC: count every unique type value in the UNKNOWN sheet.
// Run once from the editor — results appear in the execution log.
// Paste the sanitized values into TYPE_CANONICAL to eliminate UNKNOWN rows.
// ─────────────────────────────────────────────────────────────────────────────

function auditUnknownTypes() {
  // Reads the raw-type tracker built during import (not the sheet)
  // so you see the ORIGINAL satellite type strings, not "UNKNOWN"
  const props = PropertiesService.getScriptProperties();
  const stored = props.getProperty(FleetImport_.PROP_UNKNOWN_TYPES);
  if (!stored) {
    Logger.log('No unknown type data recorded yet. Run a fleet import first.');
    return;
  }
  const counts = JSON.parse(stored);
  const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
  const total  = sorted.reduce((s, [,n]) => s + n, 0);

  Logger.log('==== UNKNOWN raw type audit (' + total + ' rows, ' + sorted.length + ' unique types) ====');
  sorted.forEach(function([type, n]) {
    const sanitized = type.toUpperCase()
      .replace(/[^A-Z0-9]/g, '_')
      .replace(/_+/g, '_')
      .replace(/^_|_$/g, '')
      .slice(0, 25);
    Logger.log('  ' + String(n).padStart(4) + 'x  "' + type + '"  =>  sanitized: "' + sanitized + '"');
  });
  Logger.log('==== Paste the sanitized keys into TYPE_CANONICAL to resolve. ====');
}
