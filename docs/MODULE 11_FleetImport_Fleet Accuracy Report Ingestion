// ============================================================================
// MODULE: FleetImport_ — Fleet-wide Accuracy_Report Ingestion
// VERSION: 1.1.0
// ============================================================================
//
// ENTRY POINTS (menu-callable globals):
//   runFleetImportAndAssay()      — import + run full assay
//   runFleetImportOnly()          — import only (no assay)
//   runFleetImportResume()        — resume import chunk
//   runFleetImportTest()          — test run: first 3 satellites only
//   resetFleetImport()            — clear all PropertiesService resume state
//
// ============================================================================

const FleetImport_ = {

  // ─── Constants ─────────────────────────────────────────────────────────────

  REGISTRY_URL: 'https://raw.githubusercontent.com/6ixtyn9-sudo/gold-universe-orchestrator/main/registry/registry.json',
  FOLDER_ID:    '1fZYPWLG1OKTnML0Yil82y4cAI-ioli0K',
  CHUNK_SIZE:   15,
  MARKET_PREFIX:'INTAKE__',

  // PropertiesService keys
  PROP_RESUME_IDX:  'FI_RESUME_IDX',
  PROP_RUN_ID:      'FI_RUN_ID',

  // Accuracy_Report tab aliases (exact first, then fallbacks)
  AR_TAB_ALIASES: ['Accuracy_Report', 'AccuracyReport', 'Accuracy Report', 'accuracy_report'],

  // Side columns that the existing Parser_/assay expects
  SIDE_HEADERS: [
    'satellite_id','satellite_name','league','date','time','match',
    'pick','type','confidence','tier','quarter','actual','side','outcome',
    'home','away','odds','units','ev','notes'
  ],

  // Totals columns
  TOTALS_HEADERS: [
    'satellite_id','satellite_name','league','date','home','away','match',
    'quarter','direction','line','actual','result','diff',
    'confidence','ev','tier','type','odds','units','notes'
  ],

  // OTHER dynamic tabs stable schema
  OTHER_HEADERS: [
    'SatelliteID', 'League', 'Date', 'Time', 'Home', 'Away', 'Match',
    'Market', 'Period', 'Quarter', 'Pick', 'Direction', 'Line',
    'Confidence', 'Tier', 'Odds', 'Units', 'EV',
    'Outcome', 'Actual', 'Notes', 'SourceSheetId', 'SourceSheetName', 'ImportedAt'
  ],

  // Market routing table — keyed on normalised type/market string fragments
  MARKET_MAP: {
    // ── SIDE ──
    SIDE: [
      'moneyline','money line','winner','1x2','banker','robber',
      'margin','spread','first half winner','1h winner','1h side',
      'side','h/a','home away'
    ],
    // ── TOTALS ──
    TOTALS: [
      'over','under','o/u','ou','total','sniper o','sniper u',
      'quarter o','quarter u','1q o','2q o','3q o','4q o',
      'half o','half u','full time ou','ft ou','ht ou'
    ]
  },

  // ─── Public orchestrator ───────────────────────────────────────────────────

  runFullAssayFromFleet(opts) {
    opts = opts || {};
    const log = Log_.module('FLEET_IMPORT');
    Log_.init();
    const ss = SpreadsheetApp.getActiveSpreadsheet();

    log.info('═══ FLEET IMPORT + ASSAY START ═══');

    const importOk = this.importAccuracyReports_(ss, opts, log);

    if (!importOk) {
      log.error('Import failed or paused — assay NOT started. See log above.');
      Log_.writeToSheet(ss);
      return;
    }

    // Verify Side and Totals have data
    const sideSheet = ss.getSheetByName(Config_.sheets.side);
    const totalsSheet = ss.getSheetByName(Config_.sheets.totals);
    const sideRows = sideSheet ? Math.max(0, sideSheet.getLastRow() - 1) : 0;
    const totalsRows = totalsSheet ? Math.max(0, totalsSheet.getLastRow() - 1) : 0;

    if (sideRows === 0 && totalsRows === 0) {
       log.error('STOP: Zero rows in Side and Totals after import. Aborting assay.');
       Log_.writeToSheet(ss);
       return;
    }

    log.info('Import succeeded — launching Main_.runAssay()');

    try {
      Main_.runAssay();
    } catch (e) {
      log.error('Main_.runAssay() threw: ' + e.message, e.stack);
    }

    Log_.writeToSheet(ss);
  },

  // ─── Core import ──────────────────────────────────────────────────────────

  importAccuracyReports_(ss, opts, log) {
    opts = opts || {};
    log  = log  || Log_.module('FLEET_IMPORT');

    const satellites = this.discoverSatellites_(log);
    if (!satellites || satellites.length === 0) {
      log.error('STOP: No satellites discovered. Cannot import.');
      return false;
    }

    const limit = opts.limit || satellites.length;
    const satList = satellites.slice(0, limit);
    const total   = satList.length;
    log.info(`Satellites to process: ${total} (limit=${limit})`);

    const props = PropertiesService.getScriptProperties();
    let startIdx = 0;
    if (opts.resume) {
      startIdx = parseInt(props.getProperty(this.PROP_RESUME_IDX) || '0', 10);
      log.info(`Resuming from satellite index ${startIdx}`);
    } else {
      props.deleteProperty(this.PROP_RESUME_IDX);
      props.setProperty(this.PROP_RUN_ID, Utils_.generateId('FI'));
    }
    const runId = props.getProperty(this.PROP_RUN_ID) || 'UNKNOWN';

    const buckets = {
      [Config_.sheets.side]:   [],  
      [Config_.sheets.totals]: []   
    };
    
    const runReport = {
      runId,
      started:    new Date().toISOString(),
      attempted:  0,
      succeeded:  0,
      skipped:    0,
      missing_ar: 0,
      headerFails: 0,
      schemaFails: 0,
      rowsBySide:   0,
      rowsByTotals: 0,
      rowsByOther:  0,
      weakKeys: 0,
      unknownMarkets: {},
      headerPatterns: {},
      errors: [],
      sampleHeaderRow: null,
      sampleResolved: null
    };

    const clearBefore = opts.clearBeforeImport !== false;
    if (!opts.resume && clearBefore) {
      this._clearIntakeTabs_(ss, log);
    }

    const deadline = Date.now() + 270000; // 4.5 minutes

    for (let i = startIdx; i < satList.length; i++) {

      if (Date.now() > deadline) {
        log.warn(`Approaching 4.5-min limit at satellite ${i}. Saving resume state.`);
        props.setProperty(this.PROP_RESUME_IDX, String(i));
        log.info('Run will auto-resume. Trigger setupOneTimeTrigger or re-run manually.');
        this._flushBuckets_(ss, buckets, log, runReport);
        this._writeRunReport_(ss, runReport, log);
        Log_.writeToSheet(ss);
        return false; 
      }

      const sat = satList[i];
      runReport.attempted++;

      log.info(`[${i+1}/${total}] ${sat.name} (${sat.id})`);

      try {
        const result = this.readAccuracyReport_(sat.id, log);

        if (!result) {
          log.warn(`  → No Accuracy_Report tab found. Skipping.`);
          runReport.missing_ar++;
          runReport.skipped++;
          continue;
        }

        const { headers, rows, headerIdx } = result;

        if (headerIdx === -1) {
           runReport.errors.push({ sat: sat.id, reason: 'HEADER_NOT_FOUND' });
           runReport.headerFails++;
           runReport.skipped++;
           continue;
        }

        log.info(`  → ${rows.length} data rows`);

        if (rows.length === 0) {
          runReport.skipped++;
          continue;
        }

        const headerPat = headers.slice(0,10).join('|');
        runReport.headerPatterns[headerPat] = (runReport.headerPatterns[headerPat] || 0) + 1;

        ColResolver_.init();
        const resolveResult = ColResolver_.resolve(
          headers, Config_.sideColumnAliases, `AR_${sat.id.slice(0,8)}`
        );
        const resolved = resolveResult.resolved;

        const hasMarket = resolved['type'] !== undefined;
        const hasOutcome = resolved['outcome'] !== undefined || resolved['result'] !== undefined;
        const hasDate = resolved['date'] !== undefined || resolved['time'] !== undefined;
        const hasMatch = resolved['match'] !== undefined || (resolved['home'] !== undefined && resolved['away'] !== undefined);

        if (!hasMarket || !hasOutcome || !hasDate || !hasMatch) {
          const missingCanons = [];
          if (!hasMarket) missingCanons.push('market/type');
          if (!hasOutcome) missingCanons.push('outcome/result');
          if (!hasDate) missingCanons.push('date');
          if (!hasMatch) missingCanons.push('match OR (home+away)');

          log.warn(`  → COLUMN_RESOLUTION_FAILED sat=${sat.id}`);
          log.warn(`      chosenHeaderRowIndex=${headerIdx + 1}`);
          log.warn(`      headers=[${headers.join(',')}]`);
          log.warn(`      missing=${missingCanons.join(',')}`);

          runReport.errors.push({ sat: sat.id, reason: 'COLUMN_RESOLUTION_FAILED', missing: missingCanons, headers });
          runReport.schemaFails++;
          runReport.skipped++;
          continue;
        }

        if (runReport.succeeded === 0) {
            runReport.sampleHeaderRow = headers;
            runReport.sampleResolved = resolved;
        }

        const seenMarkets = new Set();
        let satSide = 0, satTotals = 0, satOther = 0;
        let satSkippedBad = 0;

        for (let r = 0; r < rows.length; r++) {
          const raw = rows[r];
          if (raw.every(c => c === '' || c === null || c === undefined)) {
             satSkippedBad++;
             continue;
          }

          const rowObj = this._buildRowObj_(raw, headers, resolved);
          rowObj.satellite_id   = sat.id;
          rowObj.satellite_name = sat.name;

          const routing = this.routeRowToMarket_(rowObj);

          const keyComps = [
              sat.id,
              rowObj.league || '',
              rowObj.date || '',
              rowObj.home || '',
              rowObj.away || '',
              rowObj.market || rowObj.type || '',
              rowObj.quarter || rowObj.period || '',
              rowObj.pick || '',
              rowObj.line || '',
              rowObj.direction || '',
              rowObj.odds || ''
          ];
          const strongKey = keyComps.map(s => String(s).toUpperCase().trim()).join('|');
          
          let weakKey = false;
          const meaningfulFields = keyComps.slice(1).filter(s => String(s).trim() !== '').length;
          if (meaningfulFields < 3) {
             weakKey = true;
             runReport.weakKeys++;
          }

          const bucketItem = { key: strongKey, weak: weakKey };

          if (routing.assayGroup === 'SIDE') {
            bucketItem.data = this._toSideRow_(rowObj);
            buckets[Config_.sheets.side].push(bucketItem);
            satSide++;
          } else if (routing.assayGroup === 'TOTALS') {
            bucketItem.data = this._toTotalsRow_(rowObj);
            buckets[Config_.sheets.totals].push(bucketItem);
            satTotals++;
          } else {
            if (!buckets[routing.destTab]) buckets[routing.destTab] = [];
            bucketItem.data = this._toOtherRow_(rowObj);
            buckets[routing.destTab].push(bucketItem);
            satOther++;
            
            if (!seenMarkets.has(routing.market)) {
                seenMarkets.add(routing.market);
                log.warn(`UNASSAYED_MARKET: ${routing.market} → ${routing.destTab}`);
            }
            runReport.unknownMarkets[routing.market] = (runReport.unknownMarkets[routing.market] || 0) + 1;
          }
        }

        log.info(`  → Routed: SIDE=${satSide} TOTALS=${satTotals} OTHER=${satOther} SKIPPED_BLANK=${satSkippedBad}`);
        runReport.rowsBySide   += satSide;
        runReport.rowsByTotals += satTotals;
        runReport.rowsByOther  += satOther;
        runReport.succeeded++;

      } catch (e) {
        log.error(`  → ERROR sat=${sat.id}: ${e.message}`);
        runReport.errors.push({ sat: sat.id, reason: e.message });
        runReport.skipped++;
      }
    }

    this._flushBuckets_(ss, buckets, log, runReport);
    this._writeRunReport_(ss, runReport, log);
    props.deleteProperty(this.PROP_RESUME_IDX);

    log.info('═══ FLEET IMPORT COMPLETE ═══');
    log.info(`Attempted=${runReport.attempted} Succeeded=${runReport.succeeded} Skipped=${runReport.skipped}`);
    log.info(`Rows: SIDE=${runReport.rowsBySide} TOTALS=${runReport.rowsByTotals} OTHER=${runReport.rowsByOther}`);

    if (runReport.rowsBySide === 0 && runReport.rowsByTotals === 0) {
      log.error(`STOP: Zero rows routed to Side or Totals.`);
      log.error(`Diagnostics: HeaderFails=${runReport.headerFails}, SchemaFails=${runReport.schemaFails}`);
      return false;
    }

    return true;
  },

  // ─── Satellite discovery ──────────────────────────────────────────────────

  discoverSatellites_(log) {
    log = log || Log_.module('FLEET_DISCOVER');
    log.info('Discovering satellites from registry.json...');
    try {
      const resp = UrlFetchApp.fetch(this.REGISTRY_URL, { muteHttpExceptions: true });
      if (resp.getResponseCode() !== 200) throw new Error('HTTP ' + resp.getResponseCode());

      const json = JSON.parse(resp.getContentText());
      const sats = json.satellites || [];
      log.info(`Registry: ${sats.length} satellites loaded.`);
      return sats; 
    } catch (e) {
      log.warn('Registry fetch failed: ' + e.message + ' — falling back to Drive folder.');
      return this._discoverFromDrive_(log);
    }
  },

  _discoverFromDrive_(log) {
    try {
      const folder = DriveApp.getFolderById(this.FOLDER_ID);
      const files  = folder.getFilesByType(MimeType.GOOGLE_SHEETS);
      const sats   = [];
      while (files.hasNext()) {
        const f = files.next();
        sats.push({ id: f.getId(), name: f.getName() });
      }
      log.info(`Drive fallback: ${sats.length} satellites found.`);
      return sats;
    } catch (e) {
      log.error('Drive fallback also failed: ' + e.message);
      return [];
    }
  },

  // ─── Read Accuracy_Report ─────────────────────────────────────────────────

  readAccuracyReport_(satSheetId, log) {
    log = log || Log_.module('AR_READER');
    let sat;
    try {
      sat = SpreadsheetApp.openById(satSheetId);
    } catch (e) {
      log.warn(`Cannot open satellite ${satSheetId}: ${e.message}`);
      return null;
    }

    let arSheet = null;
    for (const alias of this.AR_TAB_ALIASES) {
      arSheet = sat.getSheetByName(alias);
      if (arSheet) break;
    }
    if (!arSheet) return null;

    const maxRows = Math.min(60, arSheet.getLastRow());
    const maxCols = Math.min(80, arSheet.getLastColumn());
    if (maxRows === 0 || maxCols === 0) return { headers: [], rows: [], headerIdx: -1 };

    const data = arSheet.getRange(1, 1, maxRows, maxCols).getValues();

    const tokens = ['league', 'date', 'match', 'market', 'type', 'pick', 'outcome', 'odds', 'units', 'confidence', 'tier', 'quarter', 'period', 'home', 'away', 'line', 'over', 'under', 'result', 'actual', 'ev'];

    let bestScore = -1;
    let bestRowIdx = -1;
    let bestTokensHit = 0;
    let bestNonEmpty = 0;

    for (let r = 0; r < data.length; r++) {
      const row = data[r];
      let nonEmpty = 0;
      let tokenHits = 0;
      let isBanner = false;

      const joined = row.join('|').toLowerCase();
      if (joined.includes('accuracy report') || joined.includes('golide')) {
        isBanner = true;
      }

      for (const cell of row) {
        if (cell !== '' && cell !== null && cell !== undefined) {
          nonEmpty++;
          const cLower = String(cell).toLowerCase().trim();
          if (tokens.some(t => cLower.includes(t) || t.includes(cLower))) {
            tokenHits++;
          }
        }
      }

      let score = (nonEmpty * 1) + (tokenHits * 3);
      if (isBanner && tokenHits < 3) {
        score -= 20; 
      }

      if (score > bestScore) {
        bestScore = score;
        bestRowIdx = r;
        bestTokensHit = tokenHits;
        bestNonEmpty = nonEmpty;
      }
    }

    if (bestRowIdx === -1 || bestNonEmpty < 6 || bestTokensHit < 3) {
      log.warn(`HEADER_NOT_FOUND sat=${satSheetId} (best score=${bestScore}, bestIdx=${bestRowIdx}, nonEmpty=${bestNonEmpty}, hits=${bestTokensHit})`);
      return { headers: [], rows: [], headerIdx: -1 };
    }

    let finalHeaders = data[bestRowIdx].map(h => String(h || '').trim());
    
    if (bestRowIdx + 1 < data.length) {
      let nextRowStringCount = 0;
      const nextRow = data[bestRowIdx + 1];
      for (const cell of nextRow) {
          if (cell !== '' && typeof cell === 'string' && isNaN(cell)) {
              nextRowStringCount++;
          }
      }
      if (nextRowStringCount > 5) { 
          for (let i = 0; i < finalHeaders.length; i++) {
              const subH = String(nextRow[i] || '').trim();
              if (subH) finalHeaders[i] = finalHeaders[i] ? finalHeaders[i] + ' ' + subH : subH;
          }
          bestRowIdx++; 
      }
    }
    
    log.info(`Chosen header row index (1-based) = ${bestRowIdx + (nextRowStringCount > 5 ? 0 : 1)}`);
    log.info(`Header non-empty count = ${bestNonEmpty}, tokenHits = ${bestTokensHit}`);
    log.info(`Headers preview = [${finalHeaders.slice(0, 10).join(', ')}] (trimmed)`);
    if (bestRowIdx + 1 < data.length) {
       log.info(`First data row preview = [${data[bestRowIdx+1].slice(0, 10).join(', ')}]`);
    }

    const fullData = arSheet.getDataRange().getValues();
    const rows = fullData.slice(bestRowIdx + 1);

    return { headers: finalHeaders, rows: rows, headerIdx: bestRowIdx };
  },

  // ─── Market routing ───────────────────────────────────────────────────────

  routeRowToMarket_(rowObj) {
    const rawType = String(rowObj.type || rowObj.market || '').toLowerCase().trim();

    for (const frag of this.MARKET_MAP.TOTALS) {
      if (rawType.includes(frag)) {
        return { market: rawType, assayGroup: 'TOTALS', destTab: Config_.sheets.totals };
      }
    }
    for (const frag of this.MARKET_MAP.SIDE) {
      if (rawType.includes(frag)) {
        return { market: rawType, assayGroup: 'SIDE', destTab: Config_.sheets.side };
      }
    }

    const sanitized = (rawType || 'unknown')
      .replace(/[^a-z0-9]/gi, '_')
      .replace(/_+/g, '_')
      .toUpperCase()
      .slice(0, 20);
    const destTab = this.MARKET_PREFIX + sanitized;
    return { market: rawType || 'UNKNOWN', assayGroup: 'OTHER', destTab };
  },

  // ─── Tab management ───────────────────────────────────────────────────────

  ensureTab_(ss, tabName, headerArray) {
    let sheet = ss.getSheetByName(tabName);
    if (!sheet) {
      sheet = ss.insertSheet(tabName);
      sheet.getRange(1, 1, 1, headerArray.length).setValues([headerArray]);
      sheet.setFrozenRows(1);
      sheet.getRange(1, 1, 1, headerArray.length)
        .setFontWeight('bold')
        .setBackground(Config_.colors.header)
        .setFontColor(Config_.colors.headerText);
    }
    return sheet;
  },

  clearStaleData_(sheet) {
    const last = sheet.getLastRow();
    if (last > 1) sheet.deleteRows(2, last - 1);
  },

  // ─── Private helpers ─────────────────────────────────────────────────────

  _clearIntakeTabs_(ss, log) {
    [Config_.sheets.side, Config_.sheets.totals].forEach(name => {
      const sh = ss.getSheetByName(name);
      if (sh) {
        this.clearStaleData_(sh);
        log.info('Cleared stale data: ' + name);
      }
    });
    ss.getSheets().forEach(sh => {
      if (sh.getName().startsWith(this.MARKET_PREFIX)) {
        this.clearStaleData_(sh);
        log.info('Cleared stale data: ' + sh.getName());
      }
    });
  },

  _buildRowObj_(raw, headers, resolved) {
    const obj = {};
    const get = (canon) => {
      const idx = resolved[canon];
      return (idx !== undefined && idx >= 0 && idx < raw.length) ? raw[idx] : '';
    };
    obj.league     = get('league');
    obj.date       = get('date');
    obj.time       = get('time');
    obj.home       = get('home');
    obj.away       = get('away');
    obj.match      = get('match');
    obj.pick       = get('pick');
    obj.type       = get('type');
    obj.market     = get('type'); 
    obj.confidence = get('confidence');
    obj.tier       = get('tier');
    obj.quarter    = get('quarter');
    obj.period     = get('quarter');
    obj.actual     = get('actual');
    obj.side       = get('side');
    obj.outcome    = get('outcome');
    obj.odds       = get('odds');
    obj.units      = get('units');
    obj.ev         = get('ev');
    obj.notes      = get('notes');
    obj.direction  = get('direction');
    obj.line       = get('line');
    obj.result     = get('result') || get('outcome');
    obj.diff       = get('diff');
    return obj;
  },

  _toSideRow_(o) {
    return [
      o.satellite_id, o.satellite_name,
      o.league, o.date, o.time, o.match,
      o.pick, o.type, o.confidence, o.tier, o.quarter,
      o.actual, o.side, o.outcome,
      o.home, o.away, o.odds, o.units, o.ev, o.notes
    ];
  },

  _toTotalsRow_(o) {
    return [
      o.satellite_id, o.satellite_name,
      o.league, o.date, o.home, o.away, o.match,
      o.quarter, o.direction, o.line, o.actual,
      o.result, o.diff,
      o.confidence, o.ev, o.tier, o.type, o.odds, o.units, o.notes
    ];
  },

  _toOtherRow_(o) {
    const importedAt = new Date().toISOString();
    return [
      o.satellite_id, o.league, o.date, o.time, o.home, o.away, o.match,
      o.market || o.type, o.period || o.quarter, o.quarter, o.pick, o.direction, o.line,
      o.confidence, o.tier, o.odds, o.units, o.ev,
      o.outcome, o.actual, o.notes, o.satellite_id, o.satellite_name, importedAt
    ];
  },

  _flushBuckets_(ss, buckets, log, runReport) {
    const seenKeys = {};

    for (const [tabName, items] of Object.entries(buckets)) {
      if (items.length === 0) continue;

      let headers;
      if (tabName === Config_.sheets.side)   headers = this.SIDE_HEADERS;
      else if (tabName === Config_.sheets.totals) headers = this.TOTALS_HEADERS;
      else headers = this.OTHER_HEADERS;

      const sheet = this.ensureTab_(ss, tabName, headers);

      const currentHeaders = sheet.getRange(1, 1, 1, sheet.getLastColumn() || 1).getValues()[0];
      if (tabName === Config_.sheets.side || tabName === Config_.sheets.totals) {
         if (currentHeaders.join(',') !== headers.join(',')) {
             log.error(`STOP: ${tabName} schema mismatch! Expected [${headers.join(',')}] but got [${currentHeaders.join(',')}]`);
             runReport.errors.push({ reason: `${tabName}_SCHEMA_MISMATCH`, expected: headers, actual: currentHeaders });
             continue; 
         }
      }

      const dedupedData = [];
      for (const item of items) {
        if (item.weak) {
            dedupedData.push(item.data);
        } else {
            const k = tabName + '|' + item.key;
            if (!seenKeys[k]) { 
                seenKeys[k] = true; 
                dedupedData.push(item.data); 
            }
        }
      }

      if (dedupedData.length > 0) {
        const nextRow = sheet.getLastRow() + 1;
        const padded = dedupedData.map(r => {
          while (r.length < headers.length) r.push('');
          return r.slice(0, headers.length);
        });
        sheet.getRange(nextRow, 1, padded.length, headers.length).setValues(padded);
        log.info(`Flushed ${padded.length} rows (out of ${items.length} pre-dedupe) → ${tabName}`);
      }
    }
  },

  _writeRunReport_(ss, report, log) {
    const TAB = 'MA_ImportReport';
    let sheet = ss.getSheetByName(TAB);
    if (!sheet) {
      sheet = ss.insertSheet(TAB);
      sheet.getRange(1,1,1,2).setValues([['Field','Value']]);
      sheet.setFrozenRows(1);
    }
    const lastR = sheet.getLastRow();
    if (lastR > 1) sheet.deleteRows(2, lastR - 1);

    const unknowns = Object.entries(report.unknownMarkets)
      .map(([m,n]) => m + ':' + n).join(', ') || 'none';

    // Top 20 header patterns
    const topHeaders = Object.entries(report.headerPatterns || {})
        .sort((a,b) => b[1] - a[1])
        .slice(0,20)
        .map(([p, c]) => `${c}x: [${p}]`)
        .join('
');

    const rows = [
      ['run_id',         report.runId],
      ['started',        report.started],
      ['finished',       new Date().toISOString()],
      ['attempted',      report.attempted],
      ['succeeded',      report.succeeded],
      ['skipped',        report.skipped],
      ['missing_ar',     report.missing_ar],
      ['header_fails',   report.headerFails],
      ['schema_fails',   report.schemaFails],
      ['rows_side',      report.rowsBySide],
      ['rows_totals',    report.rowsByTotals],
      ['rows_other',     report.rowsByOther],
      ['weak_keys',      report.weakKeys],
      ['unknown_markets',unknowns],
      ['top_header_pats',topHeaders],
      ['sample_headers', JSON.stringify(report.sampleHeaderRow || [])],
      ['sample_resolved',JSON.stringify(report.sampleResolved || {})],
      ['errors_count',   report.errors.length],
      ['error_detail',   JSON.stringify(report.errors).slice(0, 1000)]
    ];

    sheet.getRange(2, 1, rows.length, 2).setValues(rows);
    log.info('Run report written to ' + TAB);
  }
};

