// ============================================================================
// MODULE: FleetImport_ — Fleet-wide Accuracy_Report Ingestion
// VERSION: 2.0.0
// ============================================================================
//
// DESIGN: Every bet type gets its own sheet — INTAKE__BANKER, INTAKE__SNIPER_OU,
//         INTAKE__SNIPER_MARGIN, etc. No Side/Totals routing. One universal schema.
//
// ENTRY POINTS:
//   runFleetImportOnly()   — import all satellites
//   runFleetImportTest()   — test run: first 3 satellites
//   runFleetImportResume() — resume a paused run
//   resetFleetImport()     — clear resume state
//
// ============================================================================

const FleetImport_ = {

  // ─── Constants ─────────────────────────────────────────────────────────────

  REGISTRY_URL: 'https://raw.githubusercontent.com/6ixtyn9-sudo/gold-universe-orchestrator/main/registry/registry.json',
  FOLDER_ID:    '1fZYPWLG1OKTnML0Yil82y4cAI-ioli0K',
  MARKET_PREFIX: 'INTAKE__',

  PROP_RESUME_IDX: 'FI_RESUME_IDX',
  PROP_RUN_ID:     'FI_RUN_ID',

  // Accuracy_Report tab name variants
  AR_TAB_ALIASES: ['Accuracy_Report', 'AccuracyReport', 'Accuracy Report', 'accuracy_report'],

  // Universal schema — every INTAKE__ sheet uses this
  INTAKE_HEADERS: [
    'satellite_id', 'satellite_name', 'league', 'date', 'match',
    'pick', 'type', 'quarter', 'direction', 'line',
    'confidence', 'tier', 'odds', 'outcome', 'actual',
    'home', 'away', 'units', 'ev', 'notes', 'imported_at'
  ],

  // Header detection tokens
  HEADER_TOKENS: [
    'league','date','match','market','type','pick','outcome','odds',
    'confidence','tier','quarter','period','home','away','line',
    'over','under','result','actual','ev'
  ],

  // ─── Core import ──────────────────────────────────────────────────────────

  importAccuracyReports_(ss, opts, log) {
    opts = opts || {};
    log  = log  || Log_.module('FLEET_IMPORT');

    const satellites = this.discoverSatellites_(log);
    if (!satellites || satellites.length === 0) {
      log.error('No satellites discovered.');
      return false;
    }

    const limit   = opts.limit || satellites.length;
    const satList = satellites.slice(0, limit);
    const total   = satList.length;
    log.info(`Satellites to process: ${total} (limit=${limit})`);

    const props = PropertiesService.getScriptProperties();
    let startIdx = 0;
    if (opts.resume) {
      startIdx = parseInt(props.getProperty(this.PROP_RESUME_IDX) || '0', 10);
      log.info(`Resuming from index ${startIdx}`);
    } else {
      props.deleteProperty(this.PROP_RESUME_IDX);
      props.setProperty(this.PROP_RUN_ID, Utils_.generateId('FI'));
    }
    const runId = props.getProperty(this.PROP_RUN_ID) || 'UNKNOWN';

    // Report counters
    const report = {
      runId,
      started:      new Date().toISOString(),
      attempted:    0, succeeded: 0, skipped: 0,
      missing_ar:   0, headerFails: 0,
      rowsByType:   {},   // { TYPE: count }
      rowsSkipped:  0,
      errors:       [],
      sampleHeaders: null, sampleResolved: null
    };

    // buckets: { 'INTAKE__BANKER': [ {key, data}, … ], … }
    const buckets = {};

    if (!opts.resume && opts.clearBeforeImport !== false) {
      this._clearIntakeTabs_(ss, log);
    }

    const deadline = Date.now() + 270000; // 4.5 min

    for (let i = startIdx; i < satList.length; i++) {

      if (Date.now() > deadline) {
        log.warn(`Time limit at satellite ${i}. Saving resume state.`);
        props.setProperty(this.PROP_RESUME_IDX, String(i));
        this._flushBuckets_(ss, buckets, log, report);
        this._writeRunReport_(ss, report, log);
        Log_.writeToSheet(ss);
        return false;
      }

      const sat = satList[i];
      report.attempted++;
      log.info(`[${i+1}/${total}] ${sat.name} (${sat.id})`);

      try {
        const result = this.readAccuracyReport_(sat.id, log);

        if (!result) {
          log.warn(`  → No Accuracy_Report tab. Skipping.`);
          report.missing_ar++;
          report.skipped++;
          continue;
        }

        const { headers, rows, headerIdx } = result;

        if (headerIdx === -1 || rows.length === 0) {
          report.headerFails++;
          report.skipped++;
          continue;
        }

        log.info(`  → ${rows.length} data rows`);

        if (report.succeeded === 0) {
          report.sampleHeaders = headers;
        }

        // Resolve columns once per satellite
        ColResolver_.init();
        const ALIASES = {};
        for (const k in Config_.sideColumnAliases) {
          ALIASES[k] = [...Config_.sideColumnAliases[k]];
        }
        for (const k in Config_.totalsColumnAliases) {
          if (ALIASES[k]) {
            ALIASES[k] = Array.from(new Set([...ALIASES[k], ...Config_.totalsColumnAliases[k]]));
          } else {
            ALIASES[k] = [...Config_.totalsColumnAliases[k]];
          }
        }

        const { resolved } = ColResolver_.resolve(headers, ALIASES, `AR_${sat.id.slice(0,8)}`);

        if (report.succeeded === 0) report.sampleResolved = resolved;

        // Must have at least date + (match or pick)
        if (resolved['date'] === undefined) {
          log.warn(`  → No date column. Skipping.`);
          report.skipped++;
          continue;
        }

        const typeColIdx = resolved['type'];

        let satRows = 0, satSkipped = 0;

        for (let r = 0; r < rows.length; r++) {
          const raw = rows[r];

          // Skip blank rows
          if (raw.every(c => c === '' || c === null || c === undefined)) {
            satSkipped++;
            continue;
          }

          // Skip banner / log / summary rows
          const firstNonEmpty = raw.find(c => c !== '' && c !== null && c !== undefined);
          const firstStr = String(firstNonEmpty || '').trim();
          if (
            firstStr.startsWith('═') ||
            firstStr.startsWith('---') ||
            /^(source sheet|total bets|matched to|hits?:|misses?:|pushes|hit rate|metric|raw log|unique pred|\(no match)/i.test(firstStr)
          ) {
            satSkipped++;
            continue;
          }

          // Skip header-echo rows
          const rawTypeCell = (typeColIdx !== undefined && typeColIdx >= 0 && typeColIdx < raw.length)
            ? String(raw[typeColIdx] || '').trim().toLowerCase()
            : '';
          if (rawTypeCell === 'type' || rawTypeCell === 'market' || rawTypeCell === 'bet type') {
            satSkipped++;
            continue;
          }

          const rowObj = this._buildRowObj_(raw, resolved, sat);
          const tabName = this._typeToTab_(rowObj.type);

          const keyParts = [
            sat.id,
            rowObj.league, rowObj.date, rowObj.match,
            rowObj.type, rowObj.pick, rowObj.quarter,
            rowObj.direction, rowObj.line, rowObj.odds
          ];
          const key = keyParts.map(s => String(s || '').toUpperCase().trim()).join('|');

          if (!buckets[tabName]) buckets[tabName] = [];
          buckets[tabName].push({ key, data: this._toIntakeRow_(rowObj) });

          report.rowsByType[tabName] = (report.rowsByType[tabName] || 0) + 1;
          satRows++;
        }

        log.info(`  → Routed: ${satRows} rows across ${Object.keys(buckets).length} type(s), skipped: ${satSkipped}`);
        report.rowsSkipped += satSkipped;
        report.succeeded++;

      } catch (e) {
        log.error(`  → ERROR sat=${sat.id}: ${e.message}`);
        report.errors.push({ sat: sat.id, reason: e.message });
        report.skipped++;
      }
    }

    this._flushBuckets_(ss, buckets, log, report);
    this._writeRunReport_(ss, report, log);
    props.deleteProperty(this.PROP_RESUME_IDX);

    log.info('═══ FLEET IMPORT COMPLETE ═══');
    log.info(`Attempted=${report.attempted} Succeeded=${report.succeeded} Skipped=${report.skipped}`);
    const typesSummary = Object.entries(report.rowsByType).map(([t,n]) => `${t}=${n}`).join(' ');
    log.info(`Rows by type: ${typesSummary || 'none'}`);

    return report.succeeded > 0;
  },

  // ─── Type → tab name ──────────────────────────────────────────────────────

  _typeToTab_(rawType) {
    const s = String(rawType || 'UNKNOWN').trim();
    if (!s) return this.MARKET_PREFIX + 'UNKNOWN';
    const sanitized = s
      .toUpperCase()
      .replace(/[^A-Z0-9]/g, '_')
      .replace(/_+/g, '_')
      .replace(/^_|_$/g, '')
      .slice(0, 25);
    return this.MARKET_PREFIX + (sanitized || 'UNKNOWN');
  },

  // ─── Build universal row object ───────────────────────────────────────────

  _buildRowObj_(raw, resolved, sat) {
    const get = (canon) => {
      const idx = resolved[canon];
      return (idx !== undefined && idx >= 0 && idx < raw.length)
        ? String(raw[idx] ?? '').trim()
        : '';
    };

    // Extract home/away from match string if no dedicated columns
    let home = get('home');
    let away = get('away');
    if (!home && !away) {
      const m = String(get('match')).match(/^(.*?)\s+(?:vs\.?|v\.?)\s+(.*)$/i);
      if (m) { home = m[1].trim(); away = m[2].trim(); }
    }

    return {
      satellite_id:   sat.id,
      satellite_name: sat.name,
      league:         get('league'),
      date:           get('date'),
      match:          get('match'),
      pick:           get('pick'),
      type:           get('type'),
      quarter:        get('quarter'),
      direction:      get('direction'),
      line:           get('line'),
      confidence:     get('confidence'),
      tier:           get('tier'),
      odds:           get('odds'),
      outcome:        get('outcome') || get('result'),
      actual:         get('actual'),
      home,
      away,
      units:          get('units'),
      ev:             get('ev'),
      notes:          get('notes')
    };
  },

  // ─── Serialize to INTAKE_HEADERS order ───────────────────────────────────

  _toIntakeRow_(o) {
    return [
      o.satellite_id, o.satellite_name, o.league, o.date, o.match,
      o.pick, o.type, o.quarter, o.direction, o.line,
      o.confidence, o.tier, o.odds, o.outcome, o.actual,
      o.home, o.away, o.units, o.ev, o.notes,
      new Date().toISOString()
    ];
  },

  // ─── Flush all buckets to sheets ─────────────────────────────────────────

  _flushBuckets_(ss, buckets, log, report) {
    const seenKeys = {};
    const H = this.INTAKE_HEADERS;

    for (const [tabName, items] of Object.entries(buckets)) {
      if (!items.length) continue;

      const sheet = this.ensureTab_(ss, tabName, H);

      const deduped = [];
      for (const item of items) {
        const k = tabName + '|' + item.key;
        if (!seenKeys[k]) {
          seenKeys[k] = true;
          deduped.push(item.data);
        }
      }

      if (deduped.length > 0) {
        const padded = deduped.map(r => {
          while (r.length < H.length) r.push('');
          return r.slice(0, H.length);
        });
        const nextRow = sheet.getLastRow() + 1;
        sheet.getRange(nextRow, 1, padded.length, H.length).setValues(padded);
        log.info(`Flushed ${padded.length} rows → ${tabName}`);
      }
    }
  },

  // ─── Clear all INTAKE__ tabs ─────────────────────────────────────────────

  _clearIntakeTabs_(ss, log) {
    ss.getSheets().forEach(sh => {
      if (sh.getName().startsWith(this.MARKET_PREFIX)) {
        const last = sh.getLastRow();
        if (last > 1) sh.deleteRows(2, last - 1);
        log.info('Cleared: ' + sh.getName());
      }
    });
  },

  // ─── Ensure tab exists with header row ───────────────────────────────────

  ensureTab_(ss, tabName, headers) {
    let sheet = ss.getSheetByName(tabName);
    if (!sheet) {
      sheet = ss.insertSheet(tabName);
    }
    // Always re-stamp header row so schema stays consistent
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, headers.length)
      .setFontWeight('bold')
      .setBackground(Config_.colors.header)
      .setFontColor(Config_.colors.headerText);
    return sheet;
  },

  // ─── Satellite discovery ──────────────────────────────────────────────────

  discoverSatellites_(log) {
    log = log || Log_.module('FLEET_DISCOVER');
    log.info('Discovering satellites from registry.json...');
    try {
      const resp = UrlFetchApp.fetch(this.REGISTRY_URL, { muteHttpExceptions: true });
      if (resp.getResponseCode() !== 200) throw new Error('HTTP ' + resp.getResponseCode());
      const json = JSON.parse(resp.getContentText());
      const sats = json.satellites || [];
      log.info(`Registry: ${sats.length} satellites loaded.`);
      return sats;
    } catch (e) {
      log.warn('Registry fetch failed: ' + e.message + ' — falling back to Drive folder.');
      return this._discoverFromDrive_(log);
    }
  },

  _discoverFromDrive_(log) {
    try {
      const folder = DriveApp.getFolderById(this.FOLDER_ID);
      const files  = folder.getFilesByType(MimeType.GOOGLE_SHEETS);
      const sats   = [];
      while (files.hasNext()) {
        const f = files.next();
        sats.push({ id: f.getId(), name: f.getName() });
      }
      log.info(`Drive fallback: ${sats.length} satellites found.`);
      return sats;
    } catch (e) {
      log.error('Drive fallback failed: ' + e.message);
      return [];
    }
  },

  // ─── Read Accuracy_Report tab ─────────────────────────────────────────────

  readAccuracyReport_(satSheetId, log) {
    log = log || Log_.module('AR_READER');
    let sat;
    try {
      sat = SpreadsheetApp.openById(satSheetId);
    } catch (e) {
      log.warn(`Cannot open ${satSheetId}: ${e.message}`);
      return null;
    }

    let arSheet = null;
    for (const alias of this.AR_TAB_ALIASES) {
      arSheet = sat.getSheetByName(alias);
      if (arSheet) break;
    }
    if (!arSheet) return null;

    const maxRows = Math.min(60, arSheet.getLastRow());
    const maxCols = Math.min(80, arSheet.getLastColumn());
    if (maxRows === 0 || maxCols === 0) return { headers: [], rows: [], headerIdx: -1 };

    const data = arSheet.getRange(1, 1, maxRows, maxCols).getValues();
    const tokens = this.HEADER_TOKENS;

    // Find best header row
    let bestScore = -1, bestRowIdx = -1, bestTokenHits = 0, bestNonEmpty = 0;

    for (let r = 0; r < data.length; r++) {
      const row = data[r];
      let nonEmpty = 0, tokenHits = 0;
      const joined = row.join('|').toLowerCase();
      const isBanner = joined.includes('accuracy report') || joined.includes('golide');

      for (const cell of row) {
        if (cell !== '' && cell !== null && cell !== undefined) {
          nonEmpty++;
          const cLower = String(cell).toLowerCase().trim();
          if (tokens.some(t => cLower.includes(t) || (cLower.length >= 3 && t.includes(cLower)))) {
            tokenHits++;
          }
        }
      }

      let score = nonEmpty + tokenHits * 3;
      if (isBanner && tokenHits < 3) score -= 20;

      if (score > bestScore) {
        bestScore = score;
        bestRowIdx = r;
        bestTokenHits = tokenHits;
        bestNonEmpty = nonEmpty;
      }
    }

    if (bestRowIdx === -1 || bestNonEmpty < 6 || bestTokenHits < 3) {
      log.warn(`HEADER_NOT_FOUND sat=${satSheetId}`);
      return { headers: [], rows: [], headerIdx: -1 };
    }

    const finalHeaders = data[bestRowIdx].map(h => String(h || '').trim());
    log.info(`Header row ${bestRowIdx + 1}: [${finalHeaders.slice(0,10).join(', ')}]`);

    const fullData = arSheet.getDataRange().getValues();
    const rows = fullData.slice(bestRowIdx + 1);
    log.info(`→ ${rows.length} data rows`);

    return { headers: finalHeaders, rows, headerIdx: bestRowIdx };
  },

  // ─── Run report ───────────────────────────────────────────────────────────

  _writeRunReport_(ss, report, log) {
    const TAB = 'MA_ImportReport';
    let sheet = ss.getSheetByName(TAB);
    if (!sheet) {
      sheet = ss.insertSheet(TAB);
    }
    const lastR = sheet.getLastRow();
    if (lastR > 0) sheet.clearContents();

    sheet.getRange(1,1,1,2).setValues([['Field','Value']]);
    sheet.setFrozenRows(1);

    const typeBreakdown = Object.entries(report.rowsByType)
      .sort((a,b) => b[1] - a[1])
      .map(([t,n]) => `${t}:${n}`)
      .join(', ') || 'none';

    const rows = [
      ['run_id',          report.runId],
      ['started',         report.started],
      ['finished',        new Date().toISOString()],
      ['attempted',       report.attempted],
      ['succeeded',       report.succeeded],
      ['skipped',         report.skipped],
      ['missing_ar',      report.missing_ar],
      ['header_fails',    report.headerFails],
      ['rows_skipped',    report.rowsSkipped],
      ['intake_sheets',   Object.keys(report.rowsByType).length],
      ['rows_by_type',    typeBreakdown],
      ['sample_headers',  JSON.stringify(report.sampleHeaders || [])],
      ['sample_resolved', JSON.stringify(report.sampleResolved || {})],
      ['errors_count',    report.errors.length],
      ['error_detail',    JSON.stringify(report.errors).slice(0, 1000)]
    ];

    sheet.getRange(2, 1, rows.length, 2).setValues(rows);
    log.info('Run report written to ' + TAB);
  }
};

// ============================================================================
// Menu-callable globals
// ============================================================================

function runFleetImportOnly() {
  Log_.init();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT');
  FleetImport_.importAccuracyReports_(ss, { clearBeforeImport: true }, log);
  Log_.writeToSheet(ss);
}

function runFleetImportTest() {
  Log_.init();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const log = Log_.module('FLEET_IMPORT_TEST');
  log.info('TEST RUN — limit=3 satellites');
  FleetImport_.importAccuracyReports_(ss, { limit: 3, clearBeforeImport: true }, log);
  Log_.writeToSheet(ss);
}

function runFleetImportResume() {
  Log_.init();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  FleetImport_.importAccuracyReports_(ss, { resume: true }, Log_.module('FLEET_IMPORT'));
  Log_.writeToSheet(ss);
}

function resetFleetImport() {
  const props = PropertiesService.getScriptProperties();
  props.deleteProperty(FleetImport_.PROP_RESUME_IDX);
  props.deleteProperty(FleetImport_.PROP_RUN_ID);
  Logger.log('FleetImport resume state cleared.');
}
